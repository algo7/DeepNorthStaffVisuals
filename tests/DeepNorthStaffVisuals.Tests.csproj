<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs DeepNorthStaffVisuals's Unity-free rules (looks, weapon kinds, the fit math) and checks the game members the patches use
    against the game's own DLLs, outside the game. Everything that needs a live Unity engine is tested in game.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableDefaultItems>false</EnableDefaultItems>
    <!-- The game assemblies target .NET Framework; they load fine for reflection and plain data classes. -->
    <NoWarn>$(NoWarn);NU1701;MSB3277</NoWarn>
    <ValheimDir Condition="'$(ValheimDir)' == ''">$(HOME)/.local/share/Steam/steamapps/common/Valheim</ValheimDir>
    <ManagedDir Condition="'$(ManagedDir)' == ''">$(ValheimDir)/valheim_Data/Managed</ManagedDir>
    <PluginDll Condition="'$(PluginDll)' == ''">$(MSBuildProjectDirectory)/../bin/$(Configuration)/DeepNorthStaffVisuals.dll</PluginDll>
  </PropertyGroup>

  <!-- Where the game's DLLs are: the donor test reads the game's asset list next to them. -->
  <ItemGroup>
    <!-- Read by HookCheckTests: where the game DLLs and the built plugin are. -->
    <AssemblyMetadata Include="PluginDll" Value="$(PluginDll)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The hook check (HookCheck.cs) reads the built plugin and the game DLLs as files. -->
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <!-- The plugin's Harmony (HarmonyX via BepInEx.Core, the same version as the plugin, so Dependabot moves both
         together), for FakeHooks.cs. ExcludeAssets="build": its targets file keeps Mono.Cecil (and Harmony) out of
         the output, right for a plugin, not for this program. -->
    <PackageReference Include="BepInEx.Core" Version="5.4.21" ExcludeAssets="build" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ManagedDir</_Parameter1>
      <_Parameter2>$(ManagedDir)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../src/WeaponKinds.cs" />
    <Compile Include="../src/Looks.cs" />
    <Compile Include="../src/Fixes.cs" />
    <Compile Include="../src/FitMath.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="assembly_valheim">
      <HintPath>$(ManagedDir)/assembly_valheim.dll</HintPath>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(ManagedDir)/assembly_utils.dll</HintPath>
    </Reference>
    <Reference Include="assembly_guiutils">
      <HintPath>$(ManagedDir)/assembly_guiutils.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)/UnityEngine.CoreModule.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
